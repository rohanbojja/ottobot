{
  "name": "ottobot",
  "version": "1.0.0",
  "description": "OttoBot - Interactive coding agent platform with VNC and AI SDK",
  "type": "module",
  "scripts": {
    "dev": "bun run desktop:dev",
    "dev:api": "bun --watch src/index.ts",
    "dev:desktop": "bun run desktop:dev",
    "dev:web": "cd frontend && bun run dev",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "start:api": "bun dist/index.js",
    "check": "bun run typecheck",
    "check:frontend": "cd frontend && bun run check",
    "check:all": "bun run check && bun run check:frontend",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cd src-tauri && cargo check",
    "docker:agent": "docker build -f docker/Dockerfile.agent -t ottobot-agent .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.74",
    "@ai-sdk/mcp": "^1.0.42",
    "@ai-sdk/openai": "^3.0.64",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "ai": "^6.0.183",
    "ai-sdk-provider-codex-cli": "^1.2.0",
    "archiver": "^6.0.2",
    "dockerode": "^4.0.7",
    "elysia": "^1.4.28",
    "elysia-mcp": "^0.1.1",
    "nanoid": "^5.1.5",
    "winston": "^3.17.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bun": "^1.2.17",
    "@types/dockerode": "^3.3.42",
    "@tauri-apps/cli": "^2.10.1",
    "typescript": "^5.8.3"
  }
}
