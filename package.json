{
  "name": "ottobot",
  "version": "1.0.0",
  "description": "OttoBot - Interactive coding agent platform with VNC and LangGraph",
  "type": "module",
  "scripts": {
    "dev": "bun run desktop:dev",
    "dev:api": "bun --watch src/index.ts",
    "dev:desktop": "bun run desktop:dev",
    "dev:web": "cd frontend && bun run dev",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "start:api": "bun dist/index.js",
    "check": "bun run typecheck",
    "check:frontend": "cd frontend && bun run check",
    "check:all": "bun run check && bun run check:frontend",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cd src-tauri && cargo check",
    "docker:agent": "docker build -f docker/Dockerfile.agent -t ottobot-agent .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.74",
    "@ai-sdk/mcp": "^1.0.42",
    "@ai-sdk/openai": "^3.0.64",
    "@elysiajs/cors": "^0.8.0",
    "@elysiajs/swagger": "^0.8.5",
    "@modelcontextprotocol/sdk": "^1.13.3",
    "ai": "^6.0.183",
    "archiver": "^6.0.2",
    "dockerode": "^4.0.7",
    "elysia": "^1.3.5",
    "elysia-mcp": "^0.0.12",
    "nanoid": "^5.1.5",
    "winston": "^3.17.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@types/archiver": "^6.0.3",
    "@types/bun": "^1.2.17",
    "@types/dockerode": "^3.3.42",
    "@tauri-apps/cli": "^2.10.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}
