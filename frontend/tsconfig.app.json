{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@": ["src"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/lib/utils.ts",
    "src/lib/ottobot-api.ts",
    "src/lib/tauri-runtime.ts",
    "src/lib/hooks/**/*.ts",
    "src/vite-env.d.ts"
  ]
}
